rules_version = '2';

// Core Conversion — leads system rules (spec §14).
//
// Public users: NO direct Firestore access at all. Every lead is created by
// the submitAssessment Cloud Function through the Admin SDK, which bypasses
// these rules.
//
// Admin users: authenticated accounts carrying the `admin: true` custom claim
// (set via scripts/set-admin-claim.mjs) may read and update operational
// fields from the back panel. Nobody can delete through the client — archive
// instead (spec §13.3).

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /leads/{leadId} {
      allow read: if isAdmin();
      allow create: if false;   // created only by the Cloud Function (Admin SDK)
      allow delete: if false;   // never delete from the client — archive instead

      // Admins may update operational fields only; submitted answers and
      // attribution data stay immutable from the client.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'assignedTo', 'lastContactedAt', 'nextFollowUpAt',
          'internalNotes', 'history', 'isArchived', 'updatedAt'
        ]);
    }

    // Rate-limit counters are Cloud Function internals.
    match /rate_limits/{doc} {
      allow read, write: if false;
    }

    // ── SEO section ──────────────────────────────────────────────────────
    // Admin-managed SEO config. Not public: redirects are applied to the
    // static site via a generated .htaccess block on deploy, so the public
    // browser never needs to read them.
    match /redirects/{id} {
      allow read, write: if isAdmin();
    }

    // 404 log — admins review and clear; entries are created server-side
    // (a Cloud Function) later, never by the public client.
    match /error_404_log/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // Baked SEO config (scripts, and later robots/meta defaults/schema).
    // Read at deploy time via the Admin SDK, so no public client read needed.
    match /seo_config/{id} {
      allow read, write: if isAdmin();
    }

    // ── Support section ──────────────────────────────────────────────────
    // Live chat uses a capability model: the session ID is an unguessable
    // random document ID handed to the visitor by the chatStart Cloud
    // Function. Knowing the ID = owning the session (same idea as a private
    // link). Listing all sessions stays admin-only.
    match /chat_sessions/{sid} {
      allow get: if true;               // visitor re-opens their own session by ID
      allow list: if isAdmin();
      allow create: if false;           // only the chatStart Cloud Function
      allow delete: if isAdmin();

      // Visitors may only touch their typing timestamp, end the chat, or
      // request a ticket — never rewrite identity fields or reopen a chat.
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['visitor_typing_at', 'mode', 'ended_at', 'ticket_created']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['mode'])
          || request.resource.data.mode == 'ended') &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ticket_created'])
          || request.resource.data.ticket_created == true)
      );

      match /messages/{mid} {
        allow read: if true;            // scoped by the secret session ID
        allow create: if isAdmin() || (
          request.resource.data.sender_type == 'visitor' &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 4000 &&
          get(/databases/$(database)/documents/chat_sessions/$(sid)).data.mode != 'ended'
        );
        allow update, delete: if isAdmin();
      }
    }

    // Tickets are back-office only. Created by admins or by the
    // ticket-from-chat Cloud Function (Admin SDK bypasses rules).
    match /tickets/{tid} {
      allow read, write: if isAdmin();
      match /messages/{mid} {
        allow read, write: if isAdmin();
      }
    }

    // Contact form submissions arrive via the submitContact Cloud Function.
    match /contact_submissions/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // Support settings (response macros).
    match /support_config/{id} {
      allow read, write: if isAdmin();
    }

    // ── Content (blog CMS) ───────────────────────────────────────────────
    // The public site reads published posts; drafts are admin-only.
    match /blog_posts/{id} {
      allow get, list: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Visitors submit comments (always pending, validated); only approved
    // ones are publicly readable. Moderation is admin-only.
    match /blog_comments/{id} {
      allow get, list: if resource.data.status == 'approved' || isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.status == 'pending' &&
        request.resource.data.post_slug is string &&
        request.resource.data.post_slug.size() > 0 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 1 &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() >= 3 &&
        request.resource.data.content.size() <= 3000
      );
      allow update, delete: if isAdmin();
    }

    // Categories/tags picker doc.
    match /blog_config/{id} {
      allow read, write: if isAdmin();
    }

    // ── Media library index (files live in Storage) ──────────────────────
    match /media/{id} {
      allow read, write: if isAdmin();
    }

    // ── Clients suite (admin side of the client portal blueprint) ────────
    // Client-facing access comes later with its own scoped rules.
    match /clients/{id} {
      allow read, write: if isAdmin();
    }
    match /orders/{id} {
      allow read, write: if isAdmin();
    }
    match /payments/{id} {
      allow read, write: if isAdmin();
    }
    match /client_files/{id} {
      allow read, write: if isAdmin();
    }
    match /client_messages/{clientId} {
      allow read, write: if isAdmin();
      match /messages/{id} {
        allow read, write: if isAdmin();
      }
    }

    // Default deny for anything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
